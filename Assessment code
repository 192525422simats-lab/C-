// =====================================================
// CITIZEN CLASS
// =====================================================

class Citizen
{
private:
    int citizenId;
    string name;
    string phone;

public:
    // Default constructor
    Citizen()
    {
        citizenId = 0;
        name = "Unknown";
        phone = "0000000000";
    }

    // Parameterized constructor
    Citizen(int id, string n, string p)
    {
        citizenId = id;
        name = n;
        phone = p;
    }

    // Copy constructor
    Citizen(const Citizen &c)
    {
        citizenId = c.citizenId;
        name = c.name;
        phone = c.phone;
    }

    void display()
    {
        cout << left << setw(10) << citizenId
             << setw(20) << name
             << setw(15) << phone << endl;
    }

    int getId()
    {
        return citizenId;
    }
};


// =====================================================
// VIRTUAL BASE CLASS
// =====================================================

class CivicService
{
protected:
    string teamName;
    int teamId;

public:
    CivicService()
    {
        teamName = "Unknown";
        teamId = 0;
    }

    CivicService(int id, string name)
    {
        teamId = id;
        teamName = name;
    }

    virtual void respond() = 0;

    virtual void displayTeam()
    {
        cout << "Team ID: " << teamId << endl;
        cout << "Team Name: " << teamName << endl;
    }

    virtual ~CivicService()
    {
    }
};


// =====================================================
// ABSTRACT RESPONSE TEAM
// =====================================================

class ResponseTeam : virtual public CivicService
{
protected:
    int workload;
    int capacity;

public:
    ResponseTeam()
    {
        workload = 0;
        capacity = 5;
    }

    ResponseTeam(int id, string name, int cap)
        : CivicService(id, name)
    {
        workload = 0;
        capacity = cap;
    }

    virtual void respond() = 0;

    void assignWork()
    {
        if (workload < capacity)
            workload++;
    }

    int getWorkload()
    {
        return workload;
    }

    int getCapacity()
    {
        return capacity;
    }

    // Operator + : combine workload/capacity values
    int operator+(const ResponseTeam &r)
    {
        return workload + r.workload;
    }

    void displayTeam()
    {
        cout << left << setw(8) << teamId
             << setw(22) << teamName
             << setw(12) << workload
             << setw(10) << capacity << endl;
    }
};


